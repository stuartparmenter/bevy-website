---
// Mirrors macros/docs.html :: docs_menu_section_row / docs_menu_page_row
import type { Node } from "../lib/content.ts";
import type { TocEntry } from "../lib/markdown.ts";
import { pagesAndSections } from "../lib/docs.ts";
import { slugify } from "../lib/slugify.ts";
import OnThisPage from "./OnThisPage.astro";
import Self from "./DocsMenuRow.astro";
interface Props { node: Node; prefix: string; currentPath: string; currentToc: TocEntry[]; }
const { node, prefix, currentPath, currentToc } = Astro.props as Props;
const isInBranch = currentPath.includes(node.path);
const isActive = currentPath === node.path;
const id = `${prefix}-${slugify(node.path)}`;
const children = node.kind === "section" ? pagesAndSections(node) : [];
const hasChildren = children.length > 0;
let cls = "tree-menu__item";
if (isActive) cls += " tree-menu__item--active";
if (node.extra && node.extra.public_draft) { cls += " public_draft"; if (isInBranch) cls += " active_draft"; }
const labelClass = hasChildren ? "tree-menu__label tree-menu__label--with-chevron" : "tree-menu__label";
const showToc = isActive && currentToc.length > 0;
---
{hasChildren && <input id={id} class="tree-menu__state" type="checkbox" checked={isInBranch} />}
<li class={cls}>
  <div class={labelClass}>
    <a class="tree-menu__link" href={node.path}>{node.title}</a>
    {hasChildren && (
      <label class="tree-menu__toggle" for={id}>
        <img class="tree-menu__chevron" src="/assets/icon-chevron-down.svg" alt="A chevron, or V-shaped symbol" width="15" height="24" />
      </label>
    )}
    {showToc && <OnThisPage toc={currentToc} class="tree-menu__toc" />}
  </div>
  {hasChildren && (
    <ul class="tree-menu">
      {children.map((c) => <Self node={c} prefix={prefix} currentPath={currentPath} currentToc={currentToc} />)}
    </ul>
  )}
</li>
